---
import Icon from './Icon.astro';
import { TYPE_LABEL, type Project } from '../lib/projects';
import { withBase } from '../lib/url';

interface Props { project: Project; headingLevel?: 'h2' | 'h3' }
const { project, headingLevel = 'h3' } = Astro.props;
const { data } = project;
const href = withBase(`projects/${project.id}/`);
const Heading = headingLevel;
const lead = data.metrics[0];
---
<article class="card project" data-skills={data.skills.join('|')}>
  <div class="top">
    <span class="icon"><Icon name={data.icon} size={22} /></span>
    <span class="category">{data.category}</span>
    <span class="type">{TYPE_LABEL[data.type]} · {data.year}</span>
  </div>
  <Heading class="title"><a href={href}>{data.title}</a></Heading>
  <p class="summary">{data.summary}</p>
  {lead && (
    <p class="lead-metric"><strong>{lead.value}</strong> {lead.label}{lead.note && <span class="mnote"> ({lead.note})</span>}</p>
  )}
  <ul class="chips" aria-label="Tools">
    {data.stack.slice(0, 4).map((s) => <li class="chip">{s}</li>)}
  </ul>
  <div class="foot">
    <span class="read" aria-hidden="true">Read case study <Icon name="arrow" size={16} /></span>
  </div>
</article>

<style>
  .project {
    position: relative; display: flex; flex-direction: column; gap: 0.8rem;
    padding: clamp(20px, 3vw, 26px); transition: transform 0.2s, border-color 0.2s;
  }
  .project:hover { transform: translateY(-3px); border-color: var(--line-strong); }
  .project:focus-within { border-color: var(--accent); }
  .top { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .icon {
    display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px;
    background: var(--accent-soft); color: var(--accent);
  }
  .category { font-size: 0.8rem; font-weight: 600; color: var(--ink-2); }
  .type { margin-left: auto; font-size: 0.76rem; color: var(--muted); }
  .title { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 700; }
  .title a { color: var(--ink); text-decoration: none; }
  /* Whole card is clickable via the title link. */
  .title a::after { content: ''; position: absolute; inset: 0; border-radius: var(--radius); }
  .summary { color: var(--ink-2); font-size: 0.95rem; flex: 1; }
  .lead-metric { font-size: 0.86rem; color: var(--muted); border-left: 2px solid var(--accent); padding-left: 0.6rem; }
  .lead-metric strong { font-family: var(--font-mono); font-weight: 500; color: var(--ink); font-size: 0.95rem; }
  .mnote { font-size: 0.78rem; }
  .foot { display: flex; justify-content: flex-end; padding-top: 0.8rem; border-top: 1px solid var(--line); font-size: 0.84rem; }
  .read { display: inline-flex; align-items: center; gap: 0.3rem; font-weight: 600; color: var(--accent); }
</style>
