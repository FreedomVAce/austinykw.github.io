---
import { withBase } from '../../lib/url';
const dataUrl = withBase('data/recommender-demo.json');
const signals = [
  { id: 'cf', label: 'Collaborative filtering', short: 'Customers also buy', color: 'var(--series-1)' },
  { id: 'mba', label: 'Market basket', short: 'Bought together', color: 'var(--series-2)' },
  { id: 'content', label: 'Content (style match)', short: 'Matches style', color: 'var(--series-3)' },
  { id: 'curated', label: 'Curated rules', short: 'Expert pairing', color: 'var(--series-4)' },
];
---
<section class="viz-root demo recommender" data-src={dataUrl} aria-labelledby="rec-demo-title">
  <div class="demo-head">
    <p class="eyebrow">Interactive demo · synthetic data</p>
    <h2 id="rec-demo-title">Recommendation explorer</h2>
    <p class="demo-lead">
      Choose a product — or build a cart — and a customer segment. Recommendations are re-scored in your browser from
      the four signals, with the blend weights tuned for that segment. Drag the weights to see how each signal changes the list.
    </p>
  </div>

  <form class="controls rec-controls" aria-label="Recommendation controls" onsubmit="return false">
    <fieldset class="mode">
      <legend class="visually-hidden">Show</legend>
      <label><input type="radio" name="mode" value="product" checked /> Product page</label>
      <label><input type="radio" name="mode" value="cart" /> Cart</label>
    </fieldset>
    <label>Category<select name="dept"></select></label>
    <label class="wide">Product<select name="product"></select></label>
    <label>Customer segment<select name="segment">
      <option value="trade_high">Trade — high volume</option>
      <option value="trade_general" selected>Trade — general</option>
      <option value="retail">Retail</option>
    </select></label>
  </form>

  <div class="cart" hidden>
    <div class="cart-head">
      <span class="chart-title">Cart</span>
      <button type="button" class="btn btn--ghost btn--sm" data-act="add">Add selected product</button>
    </div>
    <ul class="cart-list" aria-live="polite"></ul>
  </div>

  <p class="status" role="status" aria-live="polite">Loading data…</p>

  <div class="rec-body" hidden>
    <div class="rec-grid">
      <figure class="chart-card results">
        <figcaption>
          <span class="chart-title" data-k="title">Often bought with</span>
          <ul class="legend" aria-label="Legend: signal contribution">
            {signals.map((s) => <li><span class="sq" style={`background:${s.color}`}></span>{s.short}</li>)}
          </ul>
        </figcaption>
        <ol class="rec-list"></ol>
      </figure>

      <div class="chart-card weights">
        <h3>Blend weights</h3>
        <p class="fine w-note" data-k="wnote"></p>
        {signals.map((s) => (
          <label class="range wrow">
            <span class="wlabel"><span class="sq" style={`background:${s.color}`}></span>{s.label}</span>
            <output name={`o_${s.id}`}>0.00</output>
            <input type="range" name={`w_${s.id}`} min="0" max="1" step="0.05" value="0" />
          </label>
        ))}
        <div class="wbtns">
          <button type="button" class="btn btn--ghost btn--sm" data-act="tuned">Tuned for segment</button>
          <button type="button" class="btn btn--ghost btn--sm" data-act="default">Hand-set</button>
        </div>
        <p class="fine">Weights are relative; a small popularity term breaks ties. Finish variants of anything already chosen are never recommended.</p>
      </div>
    </div>

    <figure class="chart-card eval">
      <figcaption>
        <span class="chart-title">How well each approach completes a real basket</span>
        <span class="sub">NDCG@10 on held-out Nov–Dec 2025 invoices · higher is better</span>
      </figcaption>
      <div class="bars" data-chart="eval"></div>
      <div class="tooltip" role="tooltip" hidden></div>
      <details class="table-view"><summary>Show results by segment</summary>
        <div class="table-wrap"><table class="data-table" data-table="eval"></table></div></details>
    </figure>
  </div>
</section>

<style>
  .viz-root .rec-controls { grid-template-columns: auto minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr); }
  @media (max-width: 820px) { .viz-root .rec-controls { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); } .rec-controls .wide { grid-column: 1 / -1; } }
  .mode { border: 0; padding: 0; margin: 0; display: flex; gap: 0.25rem; align-self: end; }
  .mode legend { font-size: 0.8rem; font-weight: 600; color: var(--ink-2); padding: 0; margin-bottom: 0.3rem; float: left; width: 100%; }
  .mode label { display: inline-flex !important; align-items: center; gap: 0.35rem; font-weight: 500 !important; font-size: 0.85rem !important;
    border: 1px solid var(--line-strong); border-radius: var(--radius-sm); padding: 0 0.7rem; min-height: 40px; cursor: pointer; white-space: nowrap; }
  .mode label:has(input:checked) { border-color: var(--accent); color: var(--ink); background: var(--accent-soft); }
  .mode input { accent-color: var(--accent); }

  .cart { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 0.75rem 1rem; margin-bottom: 1rem; }
  .cart-head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .cart-list { list-style: none; padding: 0; margin-top: 0.5rem; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .cart-list :global(li) { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.82rem; background: var(--surface-2);
    border: 1px solid var(--line); border-radius: 999px; padding: 0.2rem 0.3rem 0.2rem 0.75rem; }
  .cart-list :global(button) { border: 0; background: transparent; color: var(--muted); cursor: pointer; font-size: 1rem; line-height: 1;
    width: 28px; height: 28px; border-radius: 50%; }
  .cart-list :global(button:hover) { background: var(--line); color: var(--ink); }
  .cart-list :global(.empty) { border: 0; background: none; padding: 0; color: var(--muted); }

  .rec-grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 1rem; align-items: start; }
  @media (max-width: 900px) { .rec-grid { grid-template-columns: minmax(0, 1fr); } }
  .sq { display: inline-block; width: 10px; height: 10px; border-radius: 2px; flex: none; }

  .rec-list { list-style: none; padding: 0; display: grid; gap: 0.15rem; counter-reset: r; }
  .rec-list :global(li) { display: grid; grid-template-columns: 1.6rem minmax(0, 1fr); gap: 0.1rem 0.6rem; padding: 0.6rem 0.2rem;
    border-top: 1px solid var(--line); }
  .rec-list :global(li:first-child) { border-top: 0; }
  .rec-list :global(.rk) { font-family: var(--font-mono); color: var(--muted); font-size: 0.85rem; grid-row: span 3; padding-top: 0.1rem; }
  .rec-list :global(.nm) { font-weight: 600; color: var(--ink); font-size: 0.92rem; }
  .rec-list :global(.meta) { font-size: 0.78rem; color: var(--muted); }
  .rec-list :global(.stack) { display: flex; gap: 2px; height: 8px; margin-top: 0.3rem; }
  .rec-list :global(.stack span) { height: 100%; border-radius: 2px; min-width: 0; }
  .rec-list :global(.why) { font-size: 0.75rem; color: var(--text-secondary); margin-top: 0.15rem; }

  .weights h3 { font-size: 0.95rem; }
  .w-note { margin-top: 0.15rem !important; }
  .wrow { display: grid !important; grid-template-columns: 1fr auto; gap: 0.15rem 0.5rem; margin-top: 0.75rem; font-size: 0.82rem; font-weight: 500; color: var(--ink-2); }
  .wrow input { grid-column: 1 / -1; width: 100%; accent-color: var(--accent); min-height: 24px; }
  .wlabel { display: inline-flex; align-items: center; gap: 0.4rem; }
  .wrow output { font-family: var(--font-mono); color: var(--text-primary); }
  .wbtns { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem; }
  .eval { margin-top: 1rem; }
</style>

<script>
  import { mountRecommenderDemo } from '../../lib/recommender-demo';
  document.querySelectorAll<HTMLElement>('.viz-root.recommender').forEach((root) => mountRecommenderDemo(root));
</script>
