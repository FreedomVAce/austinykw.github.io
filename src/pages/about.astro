---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SkillGroups from '../components/SkillGroups.astro';
import { profile, about } from '../data/profile';
import { withBase } from '../lib/url';
---
<Base title="About" description={`About ${profile.name}: ${profile.tagline}`}>
  <section class="section">
    <div class="container about">
      <div>
        <p class="eyebrow">About</p>
        <h1 class="section-title">Hi, I'm {profile.firstName}.</h1>
        <div class="prose">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
        <div class="cta">
          <a class="btn btn--primary" href={withBase('resume/')}>View résumé</a>
          <a class="btn btn--ghost" href={withBase('contact/')}>Contact</a>
        </div>
      </div>
      <figure class="photo">
        <img src={withBase(profile.photo)} alt={`Portrait of ${profile.name}`} width="620" height="620" loading="lazy" />
        <figcaption><Icon name="pin" size={14} /> {profile.location}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How I work</p>
        <h2 class="section-title">What I bring to a team</h2>
      </div>
      <div class="grid grid--3">
        {about.strengths.map((s) => (
          <div class="card strength"><h3>{s.title}</h3><p>{s.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Toolkit</p>
        <h2 class="section-title">Skills & technologies</h2>
      </div>
      <SkillGroups />
    </div>
  </section>
</Base>

<style>
  .about { display: grid; grid-template-columns: 1.4fr 1fr; gap: clamp(32px, 6vw, 72px); align-items: start; }
  .about .prose { font-size: 1.05rem; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 2rem; }
  .photo img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 20px; border: 1px solid var(--line); }
  .photo figcaption { display: flex; align-items: center; gap: 0.35rem; margin-top: 0.75rem; color: var(--muted); font-size: 0.85rem; }
  .strength { padding: 22px; }
  .strength h3 { margin-bottom: 0.4rem; }
  .strength p { color: var(--muted); font-size: 0.93rem; }
  @media (max-width: 820px) { .about { grid-template-columns: 1fr; } .photo { max-width: 260px; order: -1; } }
</style>
