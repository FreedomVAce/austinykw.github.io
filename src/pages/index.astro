---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGroups from '../components/SkillGroups.astro';
import { profile, proof, capabilities } from '../data/profile';
import { getProjects } from '../lib/projects';
import { withBase } from '../lib/url';

const all = await getProjects();
---
<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        {profile.openToWork && <p class="status-pill"><span class="dot" aria-hidden="true"></span>Open to {profile.lookingFor}</p>}
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="tagline">{profile.tagline}</p>
        <div class="cta">
          <a class="btn btn--primary" href={withBase('projects/')}>See my work <Icon name="arrow" size={16} /></a>
          <a class="btn btn--ghost hero-ghost" href={withBase('resume/')}>Résumé</a>
        </div>
        <ul class="social">
          <li><a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={16} /> LinkedIn</a></li>
          <li><a href={profile.links.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} /> GitHub</a></li>
          <li><span><Icon name="pin" size={16} /> {profile.location}</span></li>
        </ul>
      </div>
      <div class="hero-photo">
        <img src={withBase(profile.photo)} alt={`Portrait of ${profile.name}`} width="620" height="620" />
      </div>
    </div>
    <div class="container">
      <dl class="proof" aria-label="At a glance">
        {proof.map((p) => (<div><dd>{p.value}</dd><dt>{p.label}</dt></div>))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What I do</p>
        <h2 class="section-title">Analytics, machine learning and the implementation to make it stick</h2>
        <p class="section-lead">{profile.intro}</p>
      </div>
      <div class="grid caps">
        {capabilities.map((c) => (
          <div class="cap">
            <span class="cap-icon"><Icon name={c.icon} size={20} /></span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="projects">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">My work</p>
          <h2 class="section-title">Projects</h2>
          <p class="section-lead">The business problem, what I did and the result — each with an interactive demo you can explore.</p>
        </div>
        <a class="btn btn--ghost btn--sm" href={withBase('projects/')}>Browse by skill <Icon name="arrow" size={16} /></a>
      </div>
      <div class="grid grid--2">
        {all.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Toolkit</p>
        <h2 class="section-title">Skills & technologies</h2>
      </div>
      <SkillGroups />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container closing">
      <h2 class="section-title">Let's talk</h2>
      <p class="section-lead">I'm open to {profile.lookingFor}. The quickest way to reach me is by email or LinkedIn.</p>
      <div class="cta center">
        <a class="btn btn--primary" href={withBase('contact/')}>Contact me <Icon name="arrow" size={16} /></a>
        <a class="btn btn--ghost" href={withBase('resume/')}>View résumé</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--hero-bg); color: var(--hero-ink); padding-block: clamp(48px, 8vw, 96px) clamp(32px, 5vw, 56px); }
  .hero-grid { display: grid; grid-template-columns: 1.35fr 1fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  .status-pill {
    display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; font-weight: 500;
    padding: 0.3rem 0.75rem; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--hero-muted); margin-bottom: 1.25rem;
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #6fc79b; box-shadow: 0 0 0 3px rgba(111, 199, 155, 0.2); }
  .hero h1 { color: var(--hero-ink); font-size: clamp(2.8rem, 7vw, 4.8rem); font-weight: 800; line-height: 1.02; margin-bottom: 0.6rem; }
  .role { font-family: var(--font-mono); font-size: 0.95rem; color: #d6b46f; letter-spacing: 0.04em; margin-bottom: 1.1rem; }
  .tagline { font-size: clamp(1.05rem, 2vw, 1.22rem); color: #d9dce1; max-width: 44ch; margin-bottom: 1.8rem; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.6rem; }
  .cta.center { justify-content: center; margin: 1rem 0 0; }
  .hero .btn--primary { background: #d6b46f; color: #17191e; }
  .hero .btn--primary:hover { background: #e6c88a; color: #17191e; }
  .hero-ghost { color: var(--hero-ink); border-color: rgba(255, 255, 255, 0.25); }
  .hero-ghost:hover { color: #fff; border-color: #fff; }
  .social { display: flex; gap: 1.25rem; flex-wrap: wrap; list-style: none; padding: 0; font-size: 0.88rem; }
  .social a, .social span { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--hero-muted); text-decoration: none; }
  .social a:hover { color: #fff; }
  .hero-photo { justify-self: center; width: min(100%, 340px); }
  .hero-photo img {
    width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 24px;
    border: 1px solid rgba(214, 180, 111, 0.35); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }
  .proof {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1rem;
    margin-top: clamp(32px, 5vw, 56px); padding-top: 1.5rem; border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .proof div { display: grid; gap: 0.25rem; align-content: start; }
  .proof dd { font-family: var(--font-mono); font-size: 1.5rem; color: #fff; }
  .proof dt { font-size: 0.84rem; color: var(--hero-muted); line-height: 1.45; }

  .caps { grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .cap { padding-top: 1.1rem; border-top: 2px solid var(--line); }
  .cap-icon { color: var(--accent); margin-bottom: 0.75rem; display: block; }
  .cap h3 { font-size: 1.05rem; margin-bottom: 0.35rem; }
  .cap p { color: var(--muted); font-size: 0.93rem; }

  .closing { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }

  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-photo { order: -1; justify-self: start; width: 150px; }
    .hero-photo img { border-radius: 20px; }
    .proof { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
