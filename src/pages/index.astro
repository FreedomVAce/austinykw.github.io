---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillGroups from '../components/SkillGroups.astro';
import { profile } from '../data/profile';
import { getProjects } from '../lib/projects';
import { withBase } from '../lib/url';

const featured = (await getProjects()).filter((p) => p.data.featured);

const capabilities = [
  { icon: 'database', title: 'Data pipelines', text: 'Clean, join and validate raw exports — millions of rows — into analysis-ready tables.' },
  { icon: 'chart', title: 'Statistics & forecasting', text: 'Seasonal regression, exponential smoothing and SARIMA, backtested against baselines.' },
  { icon: 'sparkles', title: 'Machine learning', text: 'Segmentation, recommendation and classification models evaluated the way they are used.' },
  { icon: 'users', title: 'Dashboards & insight', text: 'Power BI and Tableau reporting that finance, logistics and commercial teams act on.' },
];
---
<Base>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        {profile.openToWork && <p class="status-pill"><span class="dot" aria-hidden="true"></span>Open to data analyst & data science roles</p>}
        <p class="hello">Hi, I'm</p>
        <h1>{profile.name}</h1>
        <p class="role">{profile.role}</p>
        <p class="tagline">{profile.tagline}</p>
        <div class="cta">
          <a class="btn btn--primary" href={withBase('projects/')}>View projects <Icon name="arrow" size={16} /></a>
          <a class="btn btn--ghost hero-ghost" href={withBase('contact/')}>Get in touch</a>
        </div>
        <ul class="social">
          <li><a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" size={16} /> LinkedIn</a></li>
          <li><a href={profile.links.github} target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} /> GitHub</a></li>
          <li><span><Icon name="pin" size={16} /> {profile.location}</span></li>
        </ul>
      </div>
      <div class="hero-photo">
        <img src={withBase(profile.photo)} alt={`Portrait of ${profile.name}`} width="620" height="620" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What I do</p>
        <h2 class="section-title">From raw data to decisions</h2>
        <p class="section-lead">{profile.intro}</p>
      </div>
      <div class="grid caps">
        {capabilities.map((c) => (
          <div class="cap">
            <span class="cap-icon"><Icon name={c.icon} size={20} /></span>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--alt" id="projects">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 class="section-title">Featured projects</h2>
          <p class="section-lead">Each project is written up as a case study: the problem, the data, the method and what it changed.</p>
        </div>
        <a class="btn btn--ghost btn--sm" href={withBase('projects/')}>All projects <Icon name="arrow" size={16} /></a>
      </div>
      <div class="grid grid--2">
        {featured.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Toolkit</p>
        <h2 class="section-title">Skills & technologies</h2>
      </div>
      <SkillGroups />
    </div>
  </section>

  <section class="section section--alt">
    <div class="container trust">
      <span class="trust-icon"><Icon name="shield" size={26} /></span>
      <div>
        <h2>How confidential work is shown here</h2>
        <p>
          Several of these projects were built on employer data that cannot be shared. Their case studies describe the
          real problem and method, but every dataset, name and number on the public pages is either from an open public
          dataset or generated synthetically — each project is labelled with which.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container closing">
      <h2 class="section-title">Let's talk data</h2>
      <p class="section-lead">Hiring for an analytics or data science role, or want to compare notes on a project? I'd like to hear from you.</p>
      <a class="btn btn--primary" href={withBase('contact/')}>Contact me <Icon name="arrow" size={16} /></a>
    </div>
  </section>
</Base>

<style>
  .hero { background: var(--hero-bg); color: var(--hero-ink); padding-block: clamp(56px, 10vw, 112px); }
  .hero-grid { display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(32px, 6vw, 72px); align-items: center; }
  .status-pill {
    display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; font-weight: 500;
    padding: 0.3rem 0.75rem; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--hero-muted); margin-bottom: 1.5rem;
  }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #6fc79b; box-shadow: 0 0 0 3px rgba(111, 199, 155, 0.2); }
  .hello { color: var(--hero-muted); font-size: 1.1rem; }
  .hero h1 { color: var(--hero-ink); font-size: clamp(2.8rem, 7vw, 5rem); font-weight: 800; line-height: 1.02; margin-block: 0.2rem 0.6rem; }
  .role { font-family: var(--font-mono); font-size: 0.95rem; color: #d6b46f; letter-spacing: 0.04em; margin-bottom: 1.25rem; }
  .tagline { font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--hero-muted); max-width: 34ch; margin-bottom: 2rem; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 2rem; }
  .hero .btn--primary { background: #d6b46f; color: #17191e; }
  .hero .btn--primary:hover { background: #e6c88a; color: #17191e; }
  .hero-ghost { color: var(--hero-ink); border-color: rgba(255, 255, 255, 0.25); }
  .hero-ghost:hover { color: #fff; border-color: #fff; }
  .social { display: flex; gap: 1.25rem; flex-wrap: wrap; list-style: none; padding: 0; font-size: 0.88rem; }
  .social a, .social span { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--hero-muted); text-decoration: none; }
  .social a:hover { color: #fff; }
  .hero-photo { justify-self: center; width: min(100%, 380px); }
  .hero-photo img {
    width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; border-radius: 24px;
    border: 1px solid rgba(214, 180, 111, 0.35); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
  }

  .caps { grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
  .cap { padding-top: 1.1rem; border-top: 2px solid var(--line); }
  .cap-icon { color: var(--accent); margin-bottom: 0.75rem; display: block; }
  .cap h3 { font-size: 1.05rem; margin-bottom: 0.35rem; }
  .cap p { color: var(--muted); font-size: 0.93rem; }

  .trust { display: flex; gap: 1.25rem; align-items: flex-start; max-width: 860px; }
  .trust-icon { flex: none; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 14px; background: var(--accent-soft); color: var(--accent); }
  .trust h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
  .trust p { color: var(--muted); }

  .closing { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .closing .btn { margin-top: 1rem; }

  @media (max-width: 820px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-photo { order: -1; justify-self: start; width: 160px; }
    .hero-photo img { border-radius: 20px; }
  }
</style>
