---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import InventoryForecast from '../../components/demos/InventoryForecast.astro';
import FreightDashboard from '../../components/demos/FreightDashboard.astro';
import RecommenderDemo from '../../components/demos/RecommenderDemo.astro';
import SegmentationDemo from '../../components/demos/SegmentationDemo.astro';
import EcommerceDashboard from '../../components/demos/EcommerceDashboard.astro';
import FaceEmotionResults from '../../components/demos/FaceEmotionResults.astro';
import AiArchitecture from '../../components/demos/AiArchitecture.astro';
import { getProjects, TYPE_LABEL, type Project } from '../../lib/projects';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

interface Props { project: Project; prev?: Project; next?: Project }
const { project, prev, next } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);
// Demo id (front matter `demo:`) -> component. Add new demos here.
const DEMOS = {
  'inventory-forecast': InventoryForecast, 'freight-dashboard': FreightDashboard, recommender: RecommenderDemo,
  segmentation: SegmentationDemo, ecommerce: EcommerceDashboard, 'face-emotion': FaceEmotionResults, 'ai-architecture': AiArchitecture,
} as const;
const Demo = data.demo ? DEMOS[data.demo] : undefined;
const toc = headings.filter((h) => h.depth === 2);
const glance = [
  { label: 'The problem', text: data.glance.problem, icon: 'chart' },
  { label: 'What I did', text: data.glance.did, icon: 'sparkles' },
  { label: 'The result', text: data.glance.result, icon: 'arrow' },
];
---
<Base title={data.title} description={data.summary}>
  <article>
    <header class="cs-head">
      <div class="container">
        <a class="back" href={withBase('projects/')}><Icon name="back" size={16} /> All projects</a>
        <p class="eyebrow">{data.category} · {TYPE_LABEL[data.type]} · {data.year}</p>
        <h1>{data.title}</h1>
        <p class="lead">{data.summary}</p>
        {data.metrics.length > 0 && (
          <dl class="metrics">
            {data.metrics.map((m) => (
              <div class="metric">
                <dd>{m.value}</dd>
                <dt>{m.label}{m.note && <span class="mnote">{m.note}</span>}</dt>
              </div>
            ))}
          </dl>
        )}
      </div>
    </header>

    <section class="container glance" aria-label="Project at a glance">
      {glance.map((g) => (
        <div class="g-item">
          <h2>{g.label}</h2>
          <p>{g.text}</p>
        </div>
      ))}
      <div class="g-item g-tools">
        <h2>Tools</h2>
        <ul class="chips">{data.stack.map((s) => <li class="chip">{s}</li>)}</ul>
      </div>
    </section>

    {Demo && (
      <div class="demo-band">
        <div class="container"><Demo /></div>
      </div>
    )}

    <div class="container cs-body">
      <aside class="side" aria-label="Project facts">
        <dl class="facts">
          <div><dt>Type</dt><dd>{TYPE_LABEL[data.type]}</dd></div>
          <div><dt>Year</dt><dd>{data.year}</dd></div>
          <div><dt>My role</dt><dd>{data.role}</dd></div>
          <div><dt>Data</dt><dd>{data.data}</dd></div>
        </dl>
        <div class="block">
          <h2>Skills shown</h2>
          <ul class="chips">{data.skills.map((s) => <li class="chip">{s}</li>)}</ul>
        </div>
        {data.links.repo && (
          <div class="block">
            <h2>Code</h2>
            <a class="code-link" href={data.links.repo} target="_blank" rel="noopener noreferrer"><Icon name="github" size={16} /> View on GitHub</a>
          </div>
        )}
        {toc.length > 2 && (
          <nav class="block toc" aria-label="On this page">
            <h2>On this page</h2>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
      </aside>

      <div class="prose">
        <Content />
      </div>
    </div>

    <nav class="container pager" aria-label="More projects">
      {prev ? <a href={withBase(`projects/${prev.id}/`)} class="card"><span>← Previous</span>{prev.data.title}</a> : <span />}
      {next ? <a href={withBase(`projects/${next.id}/`)} class="card next"><span>Next →</span>{next.data.title}</a> : <span />}
    </nav>
  </article>
</Base>

<style>
  .cs-head { background: var(--bg-alt); border-bottom: 1px solid var(--line); padding-block: clamp(32px, 6vw, 56px); }
  .back { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.88rem; text-decoration: none; margin-bottom: 1.25rem; color: var(--muted); }
  .back:hover { color: var(--ink); }
  .cs-head h1 { font-size: clamp(2.1rem, 5vw, 3.2rem); margin-bottom: 0.8rem; }
  .lead { font-size: clamp(1.05rem, 2vw, 1.2rem); color: var(--ink-2); max-width: 66ch; }
  .metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 1rem; margin-top: 1.75rem; }
  .metric { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.15rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .metric dd { font-family: var(--font-mono); font-size: 1.65rem; font-weight: 500; color: var(--ink); }
  .metric dt { font-size: 0.84rem; color: var(--ink-2); }
  .mnote { display: block; margin-top: 0.15rem; font-size: 0.74rem; color: var(--muted); }

  .glance {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 1rem;
    padding-block: clamp(28px, 4vw, 40px); border-bottom: 1px solid var(--line);
  }
  .g-item { border-top: 2px solid var(--accent); padding-top: 0.8rem; }
  .g-item h2 { font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin-bottom: 0.5rem; }
  .g-item p { font-size: 0.95rem; color: var(--ink-2); }

  .demo-band { border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--bg-alt) 45%, var(--bg)); }
  .cs-body { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); padding-block: clamp(40px, 6vw, 64px); align-items: start; }
  .side { position: sticky; top: 88px; display: flex; flex-direction: column; gap: 1.5rem; }
  .facts { display: grid; gap: 0.8rem; }
  .facts dt, .block h2 { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin-bottom: 0.25rem; }
  .facts dd { font-size: 0.88rem; color: var(--ink-2); }
  .block h2 { margin-bottom: 0.55rem; }
  .code-link { display: inline-flex; align-items: center; gap: 0.45rem; font-size: 0.9rem; font-weight: 600; text-decoration: none; }
  .toc ol { list-style: none; padding: 0; border-left: 1px solid var(--line); }
  .toc a { display: block; padding: 0.2rem 0 0.2rem 0.8rem; font-size: 0.86rem; color: var(--muted); text-decoration: none; }
  .toc a:hover { color: var(--ink); }

  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; padding-bottom: clamp(48px, 8vw, 80px); }
  .pager a { display: flex; flex-direction: column; gap: 0.2rem; padding: 1rem 1.2rem; text-decoration: none; color: var(--ink); font-weight: 600; }
  .pager a span { font-size: 0.78rem; font-weight: 500; color: var(--muted); }
  .pager a:hover { border-color: var(--accent); }
  .pager .next { text-align: right; }

  @media (max-width: 860px) {
    .cs-body { grid-template-columns: minmax(0, 1fr); }
    .side { position: static; }
    .toc { display: none; }
  }
  @media (max-width: 520px) { .pager { grid-template-columns: 1fr; } .pager .next { text-align: left; } }
</style>
